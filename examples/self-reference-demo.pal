#lang palimpsest
#fuel 500000
// Companion to SELF-REFERENCE.md — every term-level example from the tutorial,
// runnable in one shot. See the tutorial for the explanations.

rule grow   : (seed) => (sprout)
rule q      : (app ?code (quote ?data)) => (app ?data (quote ?data))
rule mirror : (self ?code (describes ?data)) => (self ?data (describes ?data))
rule flip   : (pair ?a ?b) => (pair ?b ?a)
rule rot3   : (cyc ?a ?b ?c) => (cyc ?b ?c ?a)
rule bubble : (list ?xs... ?a ?b ?ys...) => (list ?xs... ?b ?a ?ys...) where (> ?a ?b)
rule length-0 : (length (list)) => 0
rule length-n : (length (list ?x ?xs...)) => (+ 1 (length (list ?xs...)))
rule recount : (list counts ?n ?rest...) => (list counts ?len ?rest...) where ?len <- (length (list counts ?n ?rest...)), (<> ?n ?len)
rule if-t : (if true ?t ?e) => ?t
rule if-f : (if false ?t ?e) => ?e
rule fix : (fix ?f) => (app ?f (fix ?f))
rule facstep  : (app fac ?self) => (facfun ?self)
rule facapply : (app (facfun ?self) ?n) => (if (<= ?n 0) 1 (* ?n (app ?self (- ?n 1))))
rule sumstep  : (app summ ?self) => (sumfun ?self)
rule sumapply : (app (sumfun ?self) ?n) => (if (<= ?n 0) 0 (+ ?n (app ?self (- ?n 1))))

strategy sort  = repeat(oncetd(prim + rules))
strategy solve = outermost(prim + rules)

main = (nothing)

show (tree (leaf) (leaf)) with id
show (sprout) with try(grow)
show (seed) with grow
show (app quine (quote quine)) with fixpoint(q)
show (app anything (quote quine)) with fixpoint(q)
show (self me (describes me)) with mirror
show (pair x y) with flip
show (pair x y) with (flip ; flip)
show (cyc 1 2 3) with (rot3 ; rot3 ; rot3)
show (list 3 1 2) with sort
show (list 5 2 4 1 3) with (sort ; sort)
show (list counts 0 a b) with solve
show (list counts 9 a b c d e) with solve
show (app (fix fac) 5) with solve
show (app (fix summ) 10) with solve
