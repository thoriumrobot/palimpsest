#lang palimpsest
#fuel 500000
// FizzBuzz, built on the standard library. Produces a list of results for 1..n.
// (Each rule must be on a single line.)
import "../lib/prelude.pal"

rule fb : (fb ?n) => (if (= (mod ?n 15) 0) fizzbuzz (if (= (mod ?n 3) 0) fizz (if (= (mod ?n 5) 0) buzz ?n)))
rule app-fb : (app fbf ?n) => (fb ?n)

main = (map fbf (range 1 20))

run normalize
